{
	"name": "obsidian-sync-gate",
	"version": "0.1.0",
	"description": "Blocks note editing until Sync has pulled in changes from other devices.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "vitest run",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"sync"
	],
	"author": "joboyx",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/joboyx/obsidian-sync-gate.git"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "26.6.6",
		"esbuild": "0.28.2",
		"eslint": "10.14.0",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.14.0",
		"jiti": "2.7.0",
		"obsidian": "1.14.4",
		"typescript": "7.0.2",
		"typescript-eslint": "8.72.1",
		"vitest": "5.1.0"
	}
}
